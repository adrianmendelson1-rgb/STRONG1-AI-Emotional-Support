#!/usr/bin/env bash

set -euo pipefail

blocked=()

while IFS= read -r -d '' path; do
  case "$path" in
    data/*)
      [[ "$path" == "data/.gitkeep" ]] || blocked+=("$path")
      ;;
    02_SAFE_Outputs/*)
      [[ "$path" == "02_SAFE_Outputs/.gitkeep" ]] || blocked+=("$path")
      ;;
    03_Main_Outputs/*)
      [[ "$path" == "03_Main_Outputs/.gitkeep" ]] || blocked+=("$path")
      ;;
    04_Supplement/*)
      [[ "$path" == "04_Supplement/.gitkeep" ]] || blocked+=("$path")
      ;;
    *.sav|*.dta|*.rds|*.RData|*.feather|*.parquet|*.csv|*.tsv|*.xls|*.xlsx|*.xlsm|*.ods|*.fst|*.qs|SAFE_*|MAIN_Results_Tables.*|SUPPLEMENT_Results_Tables.*|Figure_1_*|Figure_2_*)
      blocked+=("$path")
      ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

if (( ${#blocked[@]} > 0 )); then
  printf '%s\n' "Commit blocked: participant data or generated outputs are staged:" >&2
  printf '  %s\n' "${blocked[@]}" >&2
  printf '%s\n' "Unstage them before committing. Do not bypass this guard." >&2
  exit 1
fi
